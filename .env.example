OPENROUTER_API_KEY=
BUILD_MODELS_JSON=[{"id":"xiaomi/mimo-v2.6-pro","name":"MiMo Pro","input":0.5,"output":0.95,"reasoning":{"enabled":false}},{"id":"z-ai/glm-5.3-flash","name":"GLM Flash","input":0.2,"output":0.7,"reasoning":{"effort":"low"}},{"id":"deepseek/deepseek-v4.1-flash","name":"DeepSeek Flash","input":0.35,"output":1.25,"reasoning":{"enabled":false}},{"id":"anthropic/claude-haiku-5.5","name":"Claude Haiku","input":0.12,"output":0.6,"reasoning":{"enabled":false}}]
COPY_AUDIT_MODEL=deepseek/deepseek-v4.1-flash
BUILD_MAX_TOKENS=24000
BUILD_MAX_ATTEMPTS=6
MODEL_TIMEOUT_MS=480000
PORT=4173
PREVIEW_PORT=4174
# Set to a public HTTPS origin for remotely reachable previews and PageSpeed.
PREVIEW_ORIGIN=http://localhost:4174
# Optional Bing Web Search API key: public profile discovery beyond linked profiles.
BING_SEARCH_KEY=
# Optional Chrome/Edge path; auto-detected on Windows and in the Docker image.
CHROME_EXECUTABLE_PATH=
# Required when binding the management app beyond loopback.
ADMIN_TOKEN=
HOST=127.0.0.1

# Vision-capable pool model used for bounded desktop/mobile screenshot review.
DESIGN_AUDIT_MODEL=z-ai/glm-5.3-flash


# Optional original image generation: shares the same per-prospect ledger.
RUNWARE_ENABLED=false
RUNWARE_API_KEY=
RUNWARE_MODEL_ID=bfl:flux@3-image-klein
RUNWARE_IMAGE_MAX_USD=0.04
RUNWARE_IMAGE_PARAMS_JSON={"width":1536,"height":1024,"steps":16}

# Vision-capable model for screenshot-aware code repairs (must be in the pool).
DESIGN_REPAIR_MODEL=anthropic/claude-haiku-5.5

# Ordered vision-capable repair pool; rotate when a visual repair fails.
DESIGN_REPAIR_MODELS_JSON=["deepseek/deepseek-v4.1-flash","z-ai/glm-5.3-flash","anthropic/claude-haiku-5.5","xiaomi/mimo-v2.6-pro"]

# Fresh layout fallback after bounded visual repairs stall.
DESIGN_RECONSTRUCTION_MODEL=xiaomi/mimo-v2.6-pro

# Bounded reasoning/output allowance for the configured vision reviewer.
DESIGN_REVIEW_MAX_TOKENS=4500

# Used only for unavailable/incomplete visual assessments, never to override a valid low score.
DESIGN_AUDIT_FALLBACK_MODEL=anthropic/claude-haiku-5.5

# One independent vote each; two of three must pass the unchanged premium bar.
DESIGN_REVIEW_MODELS_JSON=["xiaomi/mimo-v2.6-pro","deepseek/deepseek-v4.1-flash","anthropic/claude-haiku-5.5"]

# Optional approved-pool fallback for transient factual-audit provider failures.
COPY_AUDIT_FALLBACK_MODEL=

# Public preview catalog on the existing WinTech website. No credentials are exported.
PUBLIC_SITE_ORIGIN=https://www.wintechpartners.com
PUBLIC_PUBLISH_ENABLED=false
PUBLIC_SITE_CHECKOUT=
PUBLIC_RAILWAY_SCRIPT=
PUBLIC_RAILWAY_PROJECT=
PUBLIC_RAILWAY_SERVICE=
PUBLIC_RAILWAY_ENVIRONMENT=

# Cloud migration safety; exact paid responses may still be replayed.
MODEL_CALLS_ENABLED=false
WORKER_ENABLED=false
# Set a permanent activation timestamp to protect earlier prospects from new spending.
PAID_GENERATION_NEW_URLS_AFTER=
PUBLIC_PUBLISH_MODE=gateway
MIGRATION_IMPORT_ENABLED=false
